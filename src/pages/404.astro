---
// 404 ページ
// 目的: Cloudflare Pages が存在しないURLに対して HTTP 404 を返せるようにする。
// 背景: dist/404.html が無いと CF Pages はトップページのHTMLを HTTP 200 で返す（soft-404）。
//   ① クロールバジェットの浪費・soft 404 判定リスク
//   ② 「URLが200を返したらデプロイ成功」という確認が常に成功してしまう偽検証
//   の2つを同時に引き起こす（2026-08-09 監査で検出）。
import { getCollection } from 'astro:content';

const categoryLabels: Record<string, string> = {
  comparison:      '比較',
  review:          'レビュー',
  'health-column': '健康コラム',
  howto:           'ハウツー',
  'mental-health': 'メンタルヘルス',
};

// noindex ページへ誘導しないよう humanReviewed のみを候補にする
const articles = (await getCollection('articles'))
  .filter(a => a.data.humanReviewed && !a.data.noindex)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 6);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-P6YC8SXBSH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-P6YC8SXBSH');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ページが見つかりません | 時短 × 健康</title>
    <meta name="description" content="お探しのページは見つかりませんでした。時短 × 健康の記事一覧やカテゴリからお探しください。" />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>

    <header class="site-header">
      <div class="container">
        <a href="/" class="brand">
          <span class="brand-name">時短 × 健康</span>
          <span class="brand-sub">ー忙しい大人のための合理的食生活ー</span>
        </a>
      </div>
    </header>

    <main>
      <div class="container page-wrap">

        <p class="code">404</p>
        <h1 class="page-title">ページが見つかりません</h1>

        <section class="section">
          <p>お探しのページは、移動または削除された可能性があります。URLに誤りがないかご確認ください。</p>
        </section>

        <section class="section">
          <h2 class="section-h2">カテゴリから探す</h2>
          <div class="cats">
            {Object.entries(categoryLabels).map(([slug, label]) => (
              <a class="cat" href={`/${slug}/`}>{label}</a>
            ))}
          </div>
        </section>

        <section class="section">
          <h2 class="section-h2">最近の記事</h2>
          <ul class="list">
            {articles.map(a => (
              <li><a class="link" href={`/articles/${a.id}/`}>{a.data.title}</a></li>
            ))}
          </ul>
        </section>

        <section class="section">
          <a class="home" href="/">トップページへ戻る</a>
        </section>

      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="foot-links">
          <a href="/about/">運営者情報</a>・<a href="/privacy/">プライバシーポリシー</a>・<a href="/disclaimer/">免責事項</a>・<a href="/contact/">お問い合わせ</a>
        </p>
        <p class="copy">&copy; 時短 × 健康</p>
      </div>
    </footer>

  </body>
</html>

